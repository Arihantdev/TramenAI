# ── Live train data: RailRadar (recommended, default) ─────────────────────
# Free sandbox key, 1,000 requests/month: sign up at https://railradar.in
# then paste your key into Netlify (Site settings > Environment variables),
# NEVER into this file or into a VITE_ prefixed variable — RAILRADAR_API_KEY
# is read only by the server-side function in netlify/functions/live-trains.js
# and is never shipped to the browser.
# RAILRADAR_API_KEY=rr_live_your_key_here

# Local dev with Netlify CLI (`netlify dev`) picks up RAILRADAR_API_KEY from
# a .env file in the project root automatically — keep that file untracked.

# ── Live train data: fully custom feed (optional, bypasses RailRadar) ─────
# Point the frontend at your own backend/proxy instead of RailRadar. If set,
# this takes priority over RailRadar.
# VITE_TRAIN_DATA_URL=https://your-authorized-feed.example/api/trains
# TRAIN_DATA_URL=https://your-authorized-feed.example/api/trains
# TRAIN_DATA_API_KEY=your_server_only_key

# Legacy: a RapidAPI-style provider called directly from the browser. Not
# recommended (the key ships in the frontend bundle) — kept for backwards
# compatibility only. Leave unset to use the RailRadar proxy instead.
# VITE_RAPIDAPI_KEY=your_local_key_here

# Poll interval in ms (default 900000 = 15 min). RailRadar free tier is
# 1,000 req/month — at 3 tracked trains, continuous 24/7 polling at this
# interval is still ~8,600 req/month, over budget for round-the-clock use.
# LIVE mode only polls while someone is actively viewing the controller/
# copilot dashboard, so real usage is normally far lower. If you do run
# this non-stop, drop VITE_MAX_LIVE_TRAINS to 1 or raise this well above
# 15 minutes.
# VITE_TRAIN_DATA_POLL_MS=3600000

# Optional: allow Firestore to override the RailRadar LIVE feed. Keep false for
# the hackathon demo so LIVE mode never shows locally seeded train records.
# VITE_USE_FIRESTORE_LIVE=false

# Max number of trains polled for live status per cycle.
# VITE_MAX_LIVE_TRAINS=1

# ── Firebase (required — Firestore powers complaints + optional live feed) ─
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# LIVE RailRadar demo controls
VITE_MAX_LIVE_TRAINS=3
VITE_TRAIN_DATA_POLL_MS=10800000
VITE_MAX_LIVE_TRAINS=3
VITE_TRAIN_DATA_POLL_MS=10800000
